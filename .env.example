# Configuración de Firebase (variables de entorno)
# Copiá este archivo a .env y completá con los datos de tu proyecto de Firebase.
#
# Los valores se obtienen en Firebase Console:
#   Configuración del proyecto → General → Tus aplicaciones → Configuración del SDK.

VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Ruta al JSON de la cuenta de servicio (para cargar datos de ejemplo con
# el script `npm run seed`). Se descarga desde:
# Configuración del proyecto → Cuentas de servicio → Generar nueva clave privada.
FIREBASE_SERVICE_ACCOUNT_PATH=C:\ruta\al\service-account.json
